# AI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///products.db

# Notification Settings
ENABLE_NOTIFICATIONS=true
NOTIFICATION_LEAD_TIME_DAYS=7

# Manufacturing Log Import Settings
MANUFACTURING_LOG_PATH=./data/manufacturing_logs
VERIFICATION_STRICT_MODE=true

# Medicine Safety Settings
MEDICINE_INTERACTION_CHECK=true
DOSAGE_TRACKING=true

# Recipe Generation
ENABLE_RECIPE_SUGGESTIONS=true
RECIPE_COMPLEXITY=medium
